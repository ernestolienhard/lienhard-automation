# ----------------------------------------------------------------------------
# Lienhard Automation – Environment variables
# In Vercel: Project → Settings → Environment Variables (Production + Preview).
# For local dev: copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local" – it is git-ignored on purpose.
# ----------------------------------------------------------------------------

# --- Contact form email delivery (SMTP via Microsoft 365 / Outlook) ---------
# Required for the contact form to send messages.
# The mailbox needs "Authenticated SMTP" enabled and an APP PASSWORD (MFA on).

# SMTP server. Microsoft 365: smtp.office365.com  |  Outlook.com: smtp-mail.outlook.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

# The mailbox you authenticate with (login) and its APP PASSWORD (not the normal password).
SMTP_USER=info@lienhard-automation.ch
SMTP_PASS=your-app-password

# Where the contact-form notifications are sent (defaults to SMTP_USER).
CONTACT_NOTIFICATION_TO=info@lienhard-automation.ch

# Sender shown in the email. For Microsoft 365 this MUST be the SMTP_USER
# address (or an alias it is allowed to send as).
CONTACT_NOTIFICATION_FROM=Lienhard Automation <info@lienhard-automation.ch>

# --- Site -------------------------------------------------------------------
# Public site URL (used for SEO / sitemap / Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://lienhard-automation.ch
