# ----------------------------------------------------------------------------
# Lienhard Automation – Environment variables
# Copy this file to ".env.local" and fill in the real values.
# NEVER commit ".env.local" – it is git-ignored on purpose.
# ----------------------------------------------------------------------------

# Public Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose – Row Level Security protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key – SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used by the contact API route to insert submissions securely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for SEO / sitemap / Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://lienhard-automation.com

# Optional – email notifications (add later, see README)
# RESEND_API_KEY=
# CONTACT_NOTIFICATION_TO=info@lienhard-automation.com
